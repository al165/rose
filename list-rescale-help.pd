#X text 31 34 list-rescale - rescales all elements of a list;
#X text 32 203 Creation arguments: [list-rescale <in_min> <in_max> <out_min> <out_max>], f 75;
#X text 30 63 For each (numberical) element \, rescale it with the formula:;
#X text 123 101 out_min +;
#X text 215 88 x - in_min;
#X text 199 115 in_max - in_min;
#X text 199 101 ---------------;
#X text 320 101 x (out_max - out_min);
#X text 33 147 e.g. rescale a list of MIDI CC values (0-127) to (0-1);
#X text 33 223 Default values: in_min = 0 \, in_max = 127 \, out_min = 0 \, out_max = 1, f 70;
#X text 32 174 Also works for single float values;
#X listbox 231 452 20 0 0 0 - - - 0;
#X floatatom 250 382 5 0 0 0 - - - 0;
#X obj 231 417 list-rescale;
